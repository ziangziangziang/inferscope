#!/bin/sh
# A text-to-video pipeline as an engine process.
#
# Same contract as piper-server and diffusers-server: enginectl runs
# "<binary> --model <path> --port <n>", and this fixes the module behind it.
set -e
cd /workspace/inferscope
export PYTHONPATH=/workspace/inferscope
exec /opt/venv/bin/python -m inferscope.video_server "$@"
