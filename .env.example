# InferScope configuration — safe, non-secret defaults.
# Copy to .env (or export) and adjust. Nothing here is required: the app boots
# in demo mode with no GPU and no engines.

# Where sessions/traces are stored (Parquet + SQLite).
INFERSCOPE_DATA=./data

# Bind address + port. Loopback by default; access remotely via SSH -L, not by
# binding a public interface.
INFERSCOPE_HOST=127.0.0.1
INFERSCOPE_PORT=8090

# Telemetry poll interval (seconds). ~1s default; raise it to cut overhead.
INFERSCOPE_POLL_S=1

# Engine Prometheus metrics endpoints. Leave blank = adapter reports
# "not configured" (an honest state, not an error). Start your server with
# --metrics and point these at its /metrics URL.
#   llama.cpp:  llama-server --metrics  -> http://127.0.0.1:8080/metrics
#   vLLM:       vllm serve              -> http://127.0.0.1:8000/metrics
INFERSCOPE_LLAMACPP_METRICS=
INFERSCOPE_VLLM_METRICS=

# Where to look for model config.json files to derive architectures.
INFERSCOPE_MODEL_DIRS=/workspace/models

# Profiling is OFF by default and always bounded. Only `inferscope capture
# --yes` starts a capture, and it is capped at INFERSCOPE_CAPTURE_MAX_S.
INFERSCOPE_PROFILING=0
INFERSCOPE_CAPTURE_MAX_S=20

# Retention / sampling for high-volume traces.
INFERSCOPE_RETENTION_SESSIONS=50
INFERSCOPE_SAMPLE_STRIDE=1

# Demo (synthetic) session for UI development with no GPU.
INFERSCOPE_DEMO=1
